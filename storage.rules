rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function canManageWorship() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().data.get('capabilityKeys', []).hasAny(['app.admin', 'worship.manage']);
    }

    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && (fileName.matches('^' + request.auth.uid + '_.*')
            || request.auth.token.email == 'yejoon7154@gmail.com');
    }

    match /chats/{chatId}/{fileName} {
      // Read must be open too — getDownloadURL after upload requires read access.
      // Membership checks via Firestore were blocking both upload and URL fetch.
      allow read, write: if isSignedIn();
    }

    match /worshipChordSheets/{songId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if canManageWorship();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
