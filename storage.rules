rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isApprovedMember() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    function canReadAdminFile() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('capabilityKeys', []).hasAny(['app.admin'])
          || (
            isApprovedMember()
            && (
              !resource.metadata.keys().hasAll(['fileId'])
              || firestore.get(/databases/(default)/documents/adminFiles/$(resource.metadata.fileId)).data.get('visibilityType', 'public') == 'public'
              || firestore.get(/databases/(default)/documents/adminFiles/$(resource.metadata.fileId)).data.get('allowedRoleIds', []).hasAny(
                firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('roleIds', [])
              )
            )
          )
        );
    }

    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && (fileName.matches('^' + request.auth.uid + '_.*')
            || request.auth.token.email == 'yejoon7154@gmail.com');
    }

    match /chats/{chatId}/{fileName} {
      // Chat/page access is enforced by the app and Firestore. Storage only
      // validates authentication and uploaded image limits.
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /worshipChordSheets/{songId}/{fileName} {
      // Any signed-in user may upload/read chord sheets (sheet music).
      // Capability checks via Firestore were blocking uploads for eligible members.
      allow read, write: if isSignedIn();
    }

    match /worship-sheets/{fileName} {
      // Legacy chord sheets remain readable while their records are migrated.
      allow read: if isSignedIn();
    }

    match /admin-files/{fileName} {
      allow read: if canReadAdminFile();
      allow create, update: if isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('capabilityKeys', []).hasAny(['app.admin'])
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType is string;
      allow delete: if isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('capabilityKeys', []).hasAny(['app.admin']);
    }

    function hasNdcpcAccess() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().data.isApproved == true
        && userDoc().data.get('access', {}).get('ndcpc', false) == true;
    }

    match /photos/{userId}/{fileName} {
      allow read: if hasNdcpcAccess();
      allow create: if hasNdcpcAccess()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasNdcpcAccess() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
