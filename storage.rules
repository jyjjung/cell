rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function canManageWorship() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().data.get('capabilityKeys', []).hasAny(['app.admin', 'worship.manage']);
    }

    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && (fileName.matches('^' + request.auth.uid + '_.*')
            || request.auth.token.email == 'yejoon7154@gmail.com');
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.get('members', []);
    }

    match /chats/{chatId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId);
    }

    match /worshipChordSheets/{songId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if canManageWorship();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
