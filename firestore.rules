rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAppUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isAppAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true;
    }

    function isYouth(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.isYouth == true;
    }

    function userData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRoleId(userId, roleId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && roleId in userData(userId).get('roleIds', []);
    }

    // Worship Team role in production (name: "Worship Team")
    function isWorshipTeamMember(userId) {
      return hasRoleId(userId, 'nlRKkWBpxNvoIkPq2faN');
    }

    function canManageWorship(userId) {
      return isAppAdmin(userId) || isWorshipTeamMember(userId);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if isAppAdmin(request.auth.uid)
                    || (request.auth.uid == userId
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatar'])
                            || resource.data.get('avatarChangesEnabled', true) != false));
      allow delete: if isAppAdmin(request.auth.uid);
    }

    match /userBibleChecklists/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /communityProgress/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }
    
    match /roles/{roleId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }

    match /memoryVerses/{verseId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }
    
    match /qtRosters/{rosterId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }

    match /cleaningDays/{dayId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }

    match /cleaningRosters/{rosterId} {
      allow read: if request.auth != null;
      allow create, delete: if isAppAdmin(request.auth.uid);
      allow update: if isAppAdmin(request.auth.uid) ||
                     (request.auth.uid in resource.data.assignedUserIds &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCompleted', 'completedBy', 'completedAt']));
    }

    match /rosterDefinitions/{rosterDefId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);

      match /entries/{entryId} {
        allow read: if request.auth != null;
        allow write: if isAppAdmin(request.auth.uid);
      }
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAppAdmin(request.auth.uid);
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAppAdmin(request.auth.uid);
    }

    match /suggestions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAppAdmin(request.auth.uid);
    }

    function isPrayerShepherd() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 's.claire86@hotmail.com';
    }

    match /prayerRequests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.submitterId == request.auth.uid
                    && request.resource.data.keys().hasAll(['text', 'isAnonymous', 'submitterId', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.isAnonymous is bool
                    && request.resource.data.createdAt == request.time;

      allow get, list: if isPrayerShepherd()
                      || (request.auth != null && resource.data.submitterId == request.auth.uid);

      allow update: if request.auth != null
                    && resource.data.submitterId == request.auth.uid
                    && request.resource.data.submitterId == resource.data.submitterId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.isAnonymous is bool
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['text', 'isAnonymous', 'submitterDisplayName', 'updatedAt']);

      allow delete: if request.auth != null
                    && resource.data.submitterId == request.auth.uid;
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }

    match /communityLinks/{linkId} {
      allow read: if request.auth != null;
      allow write: if isAppAdmin(request.auth.uid);
    }

    match /worshipSongs/{songId} {
      allow read: if request.auth != null;
      allow write: if canManageWorship(request.auth.uid);
    }

    match /worshipSetlists/{setlistId} {
      allow read: if request.auth != null;
      allow write: if canManageWorship(request.auth.uid);
    }

    match /worshipRosters/{rosterId} {
      allow read: if request.auth != null;
      allow write: if canManageWorship(request.auth.uid);
    }

    // Chat Rules
    match /chats/{chatId} {
      function chatDoc() {
        return get(/databases/$(database)/documents/chats/$(chatId));
      }

      function isMember() {
        return request.auth != null
          && request.auth.uid in chatDoc().data.members;
      }

      function isCreatingMember() {
        return request.auth != null
          && request.auth.uid in request.resource.data.members;
      }

      function isChatAdmin() {
        return request.auth != null
          && chatDoc().data.keys().hasAny(['admins'])
          && request.auth.uid in chatDoc().data.admins;
      }

      function hasMessagePayload() {
        return request.resource.data.keys().hasAny([
          'text', 'imageUrl', 'eventId', 'setlistId', 'rosterId',
          'qtDate', 'cleaningDate', 'songId', 'threadParentId', 'systemEvent', 'poll',
        ]);
      }

      function isValidPollMap(poll) {
        return poll is map
          && poll.question is string
          && poll.question.size() > 0
          && poll.question.size() <= 500
          && poll.options is list
          && poll.options.size() >= 2
          && poll.options.size() <= 6;
      }

      function hasValidPollPayload() {
        return request.resource.data.keys().hasAll(['poll', 'pollVotes'])
          && isValidPollMap(request.resource.data.poll)
          && request.resource.data.pollVotes is map;
      }

      // Admins cannot see all chats; strictly member-only.
      // Allow get on non-existent docs so private-chat creation can check existence.
      allow get: if request.auth != null
                 && (!exists(/databases/$(database)/documents/chats/$(chatId))
                     || request.auth.uid in chatDoc().data.members);
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.members;
      allow delete: if isMember() || isAppAdmin(request.auth.uid);

      allow create: if isCreatingMember()
                    && request.resource.data.keys().hasAll(['type', 'members', 'memberInfo', 'createdAt', 'lastMessageText', 'lastMessageSentAt', 'memberSeen'])
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastMessageSentAt == request.time
                    && request.resource.data.memberSeen[request.auth.uid] == request.time
                    && (
                        request.resource.data.type == 'private' 
                        ? (
                            request.resource.data.members.size() == 2 &&
                            // Deny if both users are youth.
                            !(isYouth(request.resource.data.members[0]) && isYouth(request.resource.data.members[1]))
                          )
                        : true
                    )
                    && (
                        request.resource.data.type == 'group' 
                        ? (
                            request.resource.data.keys().hasAll(['name', 'admins']) 
                            && request.auth.uid in request.resource.data.admins
                            // Deny if the creator is youth.
                            && !isYouth(request.auth.uid)
                          ) 
                        : true
                    );

      allow update: if (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSentAt', 'lastMessageSenderId', 'typing', 'memberSeen']))
                    || (isMember() && resource.data.type == 'group' && request.resource.data.type == 'group'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'lastMessageText', 'lastMessageSentAt', 'lastMessageSenderId']))
                    || (isChatAdmin() && request.resource.data.type == 'group' && request.resource.data.diff(resource.data).hasAny(['name', 'photoURL', 'members', 'admins', 'memberInfo']))
                    || (isAppAdmin(request.auth.uid) && request.resource.data.type == 'group'); // App admin can update any group chat meta

      match /messages/{messageId} {
        allow read: if isMember();

        allow create: if isMember()
                       && request.auth.uid == request.resource.data.senderId
                       && request.resource.data.createdAt == request.time
                       && request.resource.data.seenBy.size() == 1
                       && request.resource.data.seenBy[0] == request.auth.uid
                       && (hasMessagePayload() || hasValidPollPayload())
                       && (!request.resource.data.keys().hasAny(['poll']) || hasValidPollPayload());

        allow update: if isMember()
                        && (
                           // Allow updating 'seenBy' only by adding oneself
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']) && !(request.auth.uid in resource.data.seenBy)) ||
                           // Allow updating 'reactions'
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
                           // Poll votes
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes']) && resource.data.keys().hasAny(['poll'])) ||
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes', 'pollUpdatedAt']) && resource.data.keys().hasAny(['poll'])) ||
                           // Thread summary on parent message
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'latestReplySenderId', 'latestReplyText', 'latestReplyImageUrl'])) ||
                           // Soft delete
                           (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedBy', 'text', 'imageUrl', 'eventId', 'setlistId', 'rosterId', 'qtDate', 'cleaningDate', 'songId', 'songTitle', 'sheetKey', 'threadParentId', 'reactions', 'poll', 'pollVotes', 'pollUpdatedAt']))
                        );

        match /thread/{threadMessageId} {
          allow read: if isMember();

          allow create: if isMember()
                         && request.auth.uid == request.resource.data.senderId
                         && request.resource.data.createdAt == request.time
                         && request.resource.data.seenBy.size() == 1
                         && request.resource.data.seenBy[0] == request.auth.uid
                         && hasMessagePayload();

          allow update: if isMember()
                          && (
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']) && !(request.auth.uid in resource.data.seenBy)) ||
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])) ||
                             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedBy', 'text', 'imageUrl', 'eventId', 'setlistId', 'rosterId', 'reactions']))
                          );
        }
      }
    }
  }
}
