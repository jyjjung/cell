# Public site URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ndccommunity.vercel.app

# Sentry (Student Pack / free tier). Client needs the public DSN.
# Enables error reporting + Session Replay (10% sessions / 100% on errors in production).
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional: same or server-only DSN
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional source-map upload on build (readable stack traces)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=ye-joon
# SENTRY_PROJECT=javascript-nextjs

# Cron auth (Vercel cron + manual Bearer)
CRON_SECRET=replace-with-a-long-random-value

# Admin escalate password (server action)
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional notify / ops
FEEDBACK_NOTIFY_EMAIL=you@example.com
DUTY_REMINDER_TIMEZONE=Australia/Sydney
NEXT_PUBLIC_DUTY_REMINDER_TIMEZONE=Australia/Sydney

# Web push (Firebase Cloud Messaging)
NEXT_PUBLIC_FCM_VAPID_KEY=replace-with-your-vapid-key

# Optional override if not using the default Firebase storage bucket naming
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cell-abca4.firebasestorage.app

# Firebase Admin: use these split variables, never commit real values.
FIREBASE_PROJECT_ID=cell-abca4
FIREBASE_CLIENT_EMAIL=service-account@cell-abca4.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"

# Optional alternate Admin credential (JSON). Prefer the split vars above.
# FIREBASE_SERVICE_ACCOUNT_KEY={"project_id":"...","client_email":"...","private_key":"..."}

# Legacy NDCPC Firebase (studio-7483951484-e5df7) — read-only export for migration scripts.
# NDCPC_SERVICE_ACCOUNT_JSON={"project_id":"studio-7483951484-e5df7",...}
